# Example environment file for Docker inference
# Copy this to .env.local and fill in your values

# Hugging Face token for downloading models
# Get yours from: https://huggingface.co/settings/tokens
HF_TOKEN=

# GPU to use (leave empty for default GPU 0)
# Set to comma-separated list for multi-GPU: "0,1"
CUDA_VISIBLE_DEVICES=

export WANDB_KEY=
export ENTITY=